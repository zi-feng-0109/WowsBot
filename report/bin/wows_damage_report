#!/usr/bin/env python3
"""wows_damage_report — render damage breakdown chart (two pies + ribbons).

Usage:
    wows_damage_report <replay.wowsreplay> [out_dir]

Same I/O contract as wows_report:
    stdout: PNG path (last line)
    stderr: progress logs

Internally reuses wows_report's pipeline:
    .wowsreplay → replayshark battle-report (JSON) → render_damage_chart.py
"""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from wowsbot import paths          # noqa: E402

BOT_HOME = paths.REPORT_ROOT
WOWS_REPORT = Path(paths.REPORT_BATTLE_CMD)
RENDER_PY   = Path(paths.RENDER_DAMAGE_PY)
DEFAULT_OUT = paths.OUT_DIR


def find_python() -> str:
    override = os.environ.get("WOWS_PYTHON")
    if override:
        return override
    venv = os.environ.get("WOWS_PY_VENV") or str(BOT_HOME / "venv")
    candidate = Path(venv) / "bin" / "python"
    if candidate.exists():
        return str(candidate)
    return "python3"


def main():
    if len(sys.argv) < 2:
        print("usage: wows_damage_report <replay> [out_dir]", file=sys.stderr)
        sys.exit(2)
    replay = Path(sys.argv[1]).expanduser().resolve()
    out_dir = Path(sys.argv[2] if len(sys.argv) >= 3 else DEFAULT_OUT).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)

    base = replay.stem
    json_path = out_dir / f"{base}.json"
    png_path = out_dir / f"{base}.damage.png"

    # If JSON already exists and is newer than the replay file, reuse it to
    # skip a redundant replayshark parse. (Set WOWS_FORCE_PARSE=1 to override.)
    force = os.environ.get("WOWS_FORCE_PARSE") == "1"
    reuse = (
        not force
        and json_path.exists()
        and json_path.stat().st_mtime >= replay.stat().st_mtime
    )

    if reuse:
        print(f"[1/2] reusing cached JSON at {json_path}", file=sys.stderr)
    else:
        print("[1/2] producing battle JSON ...", file=sys.stderr)
        result = subprocess.run(
            [str(WOWS_REPORT), str(replay), str(out_dir)],
            stdout=subprocess.PIPE, stderr=sys.stderr,
        )
        if result.returncode != 0:
            print("error: wows_report failed", file=sys.stderr)
            sys.exit(result.returncode)
        if not json_path.exists():
            print(f"error: expected JSON not found at {json_path}", file=sys.stderr)
            sys.exit(1)

    print("[2/2] rendering damage chart ...", file=sys.stderr)
    py = find_python()
    subprocess.run(
        [py, str(RENDER_PY), str(json_path), str(png_path)],
        check=True, stdout=sys.stderr,
    )

    print(png_path)


if __name__ == "__main__":
    main()
