#!/usr/bin/env python3
"""wows_full_report — 战报 + 复盘双图竖向拼接。

Usage:
    wows_full_report <replay.wowsreplay> [out_dir]

输出 <out_dir>/<basename>.full.png（战报在上、复盘在下）。
内部串联调用 wows_report + wows_damage_report，后者会复用前者的 JSON。
"""
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

BOT_HOME = Path(__file__).resolve().parent.parent
WOWS_REPORT        = BOT_HOME / "bin" / "wows_report"
WOWS_DAMAGE_REPORT = BOT_HOME / "bin" / "wows_damage_report"
RENDER_CRIMINALS   = BOT_HOME / "bin" / "render_criminals.py"
DEFAULT_OUT = os.environ.get("WOWS_OUT_DIR", "/tmp/wows_report")
GAP = 16
BG  = (18, 24, 38)  # GAME_BG


def find_python() -> str:
    """Same fallback chain as bin/wows_damage_report."""
    override = os.environ.get("WOWS_PYTHON")
    if override:
        return override
    venv = os.environ.get("WOWS_PY_VENV") or str(BOT_HOME / "venv")
    candidate = Path(venv) / "bin" / "python"
    if candidate.exists():
        return str(candidate)
    return "python3"


def run(cmd, extra_env=None):
    """Run sub-command, return its last stdout line (= PNG path)."""
    env = os.environ.copy()
    if extra_env:
        env.update(extra_env)
    res = subprocess.run(cmd, capture_output=True, text=True, env=env)
    sys.stderr.write(res.stderr)
    if res.returncode != 0:
        raise RuntimeError(f"{cmd[0]} exited {res.returncode}")
    return res.stdout.strip().splitlines()[-1]


def main():
    if len(sys.argv) < 2:
        print("usage: wows_full_report <replay> [out_dir]", file=sys.stderr)
        sys.exit(2)
    replay = Path(sys.argv[1]).expanduser().resolve()
    out_dir = Path(sys.argv[2] if len(sys.argv) >= 3 else DEFAULT_OUT).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)

    base = replay.stem
    out_path = out_dir / f"{base}.full.png"

    # Render intermediates into a temp dir so the canonical .png /
    # .damage.png paths in out_dir are NOT clobbered with the compact
    # versions used purely for stitching.
    with tempfile.TemporaryDirectory(prefix="wows_full_") as tmp:
        tmp_dir = Path(tmp)

        print("[1/4] 全队战报（紧凑版）...", file=sys.stderr)
        battle_path = run(
            [str(WOWS_REPORT), str(replay), str(tmp_dir)],
            extra_env={"WOWS_SKIP_PERSONAL": "1"},
        )

        # JSON 是中间产物但 wows_analyze 和 render_criminals 都会复用,拷一份到 out_dir
        tmp_json = tmp_dir / f"{base}.json"
        json_in_outdir = out_dir / f"{base}.json"
        if tmp_json.is_file():
            shutil.copy(tmp_json, json_in_outdir)

        print("[2/4] 主角复盘（无 header）...", file=sys.stderr)
        damage_path = run(
            [str(WOWS_DAMAGE_REPORT), str(replay), str(tmp_dir)],
            extra_env={"WOWS_SKIP_HEADER": "1"},
        )

        # 3) 战犯卡 — 渲到 tmp,稍后插在战报和复盘之间。
        # 飞机消耗品已通过 Avatar.squadronConsumableUsed 接入 (仅 self CV,
        # 见 render_criminals.py footer 提示),不再系统性误判 CV。
        criminals_path = None
        if json_in_outdir.is_file():
            print("[3/4] 战犯检测 ...", file=sys.stderr)
            crim_tmp = tmp_dir / f"{base}.criminals.png"
            try:
                py = find_python()
                result = subprocess.run(
                    [py, str(RENDER_CRIMINALS), str(json_in_outdir), str(crim_tmp)],
                    stdout=subprocess.PIPE, stderr=sys.stderr,
                )
                if result.returncode == 0 and crim_tmp.is_file():
                    criminals_path = crim_tmp
                elif result.returncode == 3:
                    print("      无战犯(全员合格 / 平局 / 未结束),跳过", file=sys.stderr)
                else:
                    print(f"      战犯渲染失败(exit {result.returncode}),跳过", file=sys.stderr)
            except Exception as e:
                print(f"      战犯渲染异常: {e},跳过", file=sys.stderr)

        # 4) 拼接: 战报 → 战犯(可选) → 复盘
        print("[4/4] 拼接战报 → 战犯 → 复盘 ...", file=sys.stderr)
        from PIL import Image
        battle = Image.open(battle_path).convert("RGB")
        damage = Image.open(damage_path).convert("RGB")
        W = battle.width
        if damage.width != W:
            new_h = round(damage.height * W / damage.width)
            damage = damage.resize((W, new_h), Image.LANCZOS)

        parts = [battle]
        if criminals_path:
            criminals = Image.open(criminals_path).convert("RGB")
            if criminals.width != W:
                new_h = round(criminals.height * W / criminals.width)
                criminals = criminals.resize((W, new_h), Image.LANCZOS)
            parts.append(criminals)
        parts.append(damage)

        H = sum(p.height for p in parts) + GAP * (len(parts) - 1)
        canvas = Image.new("RGB", (W, H), BG)
        y = 0
        for p in parts:
            canvas.paste(p, (0, y))
            y += p.height + GAP
        canvas.save(out_path)

    print(f"saved: {out_path}", file=sys.stderr)
    print(out_path)


if __name__ == "__main__":
    main()
