#!/usr/bin/env python3
"""wows_report — one-shot WoWs battle report generator.

Usage:
    wows_report <replay.wowsreplay> [out_dir]

Output:
    stdout: absolute path of generated PNG (last line — easy to capture from a bot)
    stderr: progress logs

Auto-handles build mismatch: if the replay's build number differs from the
canonical specs dir, creates a temporary spoofed dir (symlinks to scripts/ +
content/, fresh metadata.toml) and uses that.

Paths default to the bot deployment layout but can be overridden via env vars:
    WOWS_REPLAYSHARK   path to replayshark binary
    WOWS_SPECS_DIR     dir containing metadata.toml + scripts/ + content/
    WOWS_PY_VENV       Python venv dir (with bin/python that has PIL, polib)
    WOWS_RENDER_PY     path to render_battle_report.py
    WOWS_OUT_DIR       default output dir (overridable by arg #2)
"""
import json
import os
import re
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

# ---- locate bot home (parent of this script's dir) -------------------------
BOT_HOME = Path(__file__).resolve().parent.parent

REPLAYSHARK = os.environ.get("WOWS_REPLAYSHARK", str(BOT_HOME / "replayshark"))
SPECS_DIR   = os.environ.get("WOWS_SPECS_DIR",   str(BOT_HOME / "specs"))
CONSTANTS_JSON = os.environ.get("WOWS_CONSTANTS_JSON",
                                 str(BOT_HOME / "data" / "constants.json"))
RENDER_PY   = os.environ.get("WOWS_RENDER_PY",   str(BOT_HOME / "bin" / "render_battle_report.py"))
DEFAULT_OUT_DIR = os.environ.get("WOWS_OUT_DIR", "/tmp/wows_report")

# 按回放 build 自动挑版本目录用的两个根:
#   EXTRACTED_ROOT   放 <ver>_<build>/{metadata.toml,vfs/{scripts,content}} 的根
#   SPECS_PATCHED_ROOT  放 <ver>_<build>/scripts 的根 —— FLOAT64 手术产物
#     (15.7 起 WG 的 entity defs 用了 FLOAT64,这个预编译 replayshark 不认,
#      所以那些版本必须用手术过的 scripts 副本;<=15.6 没这问题,用原始的)
EXTRACTED_ROOT = os.environ.get("WOWS_EXTRACTED_ROOT", "/var/lib/wows-data/extracted")
SPECS_PATCHED_ROOT = os.environ.get("WOWS_SPECS_PATCHED_ROOT", "/var/lib/wows-data/specs-patched")


def find_python() -> str:
    """Pick the Python interpreter to use.

    Priority:
      1. $WOWS_PYTHON (explicit override)
      2. $WOWS_PY_VENV/bin/python (legacy venv layout)
      3. $BOT_HOME/venv/bin/python (auto-detected local venv if present)
      4. system 'python3' on PATH
    """
    override = os.environ.get("WOWS_PYTHON")
    if override:
        return override
    venv = os.environ.get("WOWS_PY_VENV") or str(BOT_HOME / "venv")
    candidate = Path(venv) / "bin" / "python"
    if candidate.exists():
        return str(candidate)
    return "python3"

REPLAY_SIGNATURE = b"\x12\x32\x34\x11"


def log(msg: str):
    print(msg, file=sys.stderr)


def read_replay_meta(path: Path) -> dict:
    with open(path, "rb") as fp:
        sig = fp.read(4)
        if sig != REPLAY_SIGNATURE:
            raise ValueError(f"not a valid WoWs replay: {path}")
        _ = fp.read(4)
        block_size = struct.unpack("i", fp.read(4))[0]
        return json.loads(fp.read(block_size))


def parse_build(meta: dict) -> int:
    ver = meta.get("clientVersionFromExe", "")
    parts = [p.strip() for p in ver.split(",")]
    if len(parts) >= 4:
        return int(parts[3])
    raise ValueError(f"cannot parse build from {ver!r}")


def read_specs_build(specs_dir):
    meta_path = specs_dir / "metadata.toml"
    if not meta_path.exists():
        return None
    for line in meta_path.read_text().splitlines():
        line = line.strip()
        if line.startswith("build"):
            _, _, val = line.partition("=")
            try:
                return int(val.strip().strip('"'))
            except ValueError:
                return None
    return None


def resolve_specs_for_build(replay_build: int):
    """按回放 build 从 EXTRACTED_ROOT 拼一份 specs 目录,拼不出返回 None。

    为什么不能只用单一 SPECS_DIR + spoof:spoof 只伪造 metadata 里的 build 号,
    entity defs 仍是 specs 指向的那个版本的。而 defs 在版本间会变(实测 15.7->15.8
    的 Avatar.def 就变了),用错版本的 defs 解析会 panic
    ("failed to deserialize player_states")。所以必须按 build 取对应版本的 defs。

    组装规则(结果是个临时目录,里面三个软链):
      metadata.toml <- extracted/<ver>_<build>/metadata.toml
      content       <- extracted/<ver>_<build>/vfs/content
      scripts       <- specs-patched/<ver>_<build>/scripts 若存在(FLOAT64 手术过的),
                       否则 extracted/<ver>_<build>/vfs/scripts
    """
    root = Path(EXTRACTED_ROOT)
    if not root.is_dir():
        return None
    match = None
    for child in root.iterdir():
        m = re.match(r"^\d+(?:\.\d+)+_(\d+)$", child.name)
        if m and int(m.group(1)) == replay_build and child.is_dir():
            match = child
            break
    if match is None:
        return None

    meta_file = match / "metadata.toml"
    content = match / "vfs" / "content"
    scripts = Path(SPECS_PATCHED_ROOT) / match.name / "scripts"
    if not scripts.is_dir():
        scripts = match / "vfs" / "scripts"
    if not (meta_file.is_file() and content.is_dir() and scripts.is_dir()):
        return None

    tmp = Path(tempfile.mkdtemp(prefix=f"wows_specs_b{replay_build}_"))
    (tmp / "metadata.toml").symlink_to(meta_file)
    (tmp / "content").symlink_to(content)
    (tmp / "scripts").symlink_to(scripts)
    return tmp


def make_spoofed_specs(canonical: Path, target_build: int, target_version: str) -> Path:
    tmp = Path(tempfile.mkdtemp(prefix=f"wows_specs_b{target_build}_"))
    (tmp / "scripts").symlink_to(canonical / "scripts")
    (tmp / "content").symlink_to(canonical / "content")
    (tmp / "metadata.toml").write_text(
        f'version = "{target_version}"\nbuild = {target_build}\n'
    )
    return tmp


def main():
    if len(sys.argv) < 2:
        log("usage: wows_report <replay.wowsreplay> [out_dir]")
        sys.exit(2)

    replay = Path(sys.argv[1]).expanduser().resolve()
    out_dir = Path(sys.argv[2] if len(sys.argv) >= 3 else DEFAULT_OUT_DIR).expanduser()

    if not replay.is_file():
        log(f"error: replay not found: {replay}")
        sys.exit(1)
    if not Path(REPLAYSHARK).exists():
        log(f"error: replayshark binary not found at {REPLAYSHARK}")
        log("  set WOWS_REPLAYSHARK env var, or build it (see DEPLOY.md)")
        sys.exit(1)

    out_dir.mkdir(parents=True, exist_ok=True)
    base = replay.stem
    json_path = out_dir / f"{base}.json"
    png_path = out_dir / f"{base}.png"

    canonical = Path(SPECS_DIR)
    meta = read_replay_meta(replay)
    replay_build = parse_build(meta)
    canonical_build = read_specs_build(canonical)
    version_str = ".".join(meta.get("clientVersionFromExe", "").split(",")[:3]) or "0.0.0"

    spoofed_dir = None
    if canonical_build is not None and replay_build == canonical_build:
        # specs 正好就是这个 build,直接用
        specs_dir = canonical
    else:
        # 优先按 build 找该版本自己的 defs —— spoof 换不了 defs,版本不对会 panic
        resolved = resolve_specs_for_build(replay_build)
        if resolved is not None:
            log(f"[specs] replay build {replay_build}: using per-build dir {resolved}")
            spoofed_dir = resolved
            specs_dir = resolved
        else:
            log(
                f"[spoof] no extracted data for build {replay_build}; falling back to "
                f"specs build {canonical_build} with faked metadata ({version_str}) "
                f"— defs may not match, parsing can fail"
            )
            spoofed_dir = make_spoofed_specs(canonical, replay_build, version_str)
            specs_dir = spoofed_dir

    try:
        log(f"[1/2] parsing replay with replayshark (specs: {specs_dir}) ...")
        cmd = [REPLAYSHARK, "-e", str(specs_dir)]
        if Path(CONSTANTS_JSON).is_file():
            cmd += ["-c", CONSTANTS_JSON]
        cmd += ["battle-report", str(replay), "-o", str(json_path)]
        subprocess.run(cmd, check=True, stdout=sys.stderr)

        log("[2/2] rendering PNG ...")
        py = find_python()
        subprocess.run(
            [py, RENDER_PY, str(json_path), str(png_path)],
            check=True, stdout=sys.stderr,
        )
    finally:
        if spoofed_dir is not None:
            for p in spoofed_dir.iterdir():
                p.unlink()
            spoofed_dir.rmdir()

    print(png_path)


if __name__ == "__main__":
    main()
