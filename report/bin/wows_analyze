#!/usr/bin/env python3
"""wows_analyze — 把战报 JSON 压成结构化摘要,交给 DeepSeek 出一段中文分析。

用法:
    wows_analyze <battle.json>

stdout: 分析文本 (整段)
stderr: 进度日志

可调环境变量:
    WOWS_DEEPSEEK_KEY    必填 — DeepSeek API key
    WOWS_DEEPSEEK_URL    默认 https://api.deepseek.com/chat/completions
    WOWS_DEEPSEEK_MODEL  默认 deepseek-chat
    WOWS_ANALYZE_TIMEOUT 默认 90 (秒)
"""
import json
import os
import random
import sys
import urllib.request
import urllib.error
from pathlib import Path

# 复用 render_battle_report 的翻译 + 常量索引工具
sys.path.insert(0, str(Path(__file__).resolve().parent))
from render_battle_report import (  # noqa: E402
    t, result_field, load_translations, load_result_indices,
    fmt_time, strip_known, strip_id, clean_ship_name, MATCH_GROUP_CN,
)
# 复用 damage-chart 的字段分类表 + 勋带映射,保证 LLM 摘要里的口径和图表一致
from render_damage_chart import (  # noqa: E402
    DEALT_CATEGORIES, RECEIVED_CATEGORIES, aggregate, extract_ribbons,
)

API_KEY     = os.environ.get("WOWS_DEEPSEEK_KEY", "")
API_URL     = os.environ.get("WOWS_DEEPSEEK_URL", "https://api.deepseek.com/chat/completions")
API_MODEL   = os.environ.get("WOWS_DEEPSEEK_MODEL", "deepseek-chat")
API_TIMEOUT = int(os.environ.get("WOWS_ANALYZE_TIMEOUT", "90"))

_BOT_DATA = Path(__file__).resolve().parent.parent / "data"
PROMPT_FILE = os.environ.get("WOWS_ANALYZE_PROMPT")  # 显式单文件强制覆盖,跳过 personas 机制
PERSONAS_DIR = Path(os.environ.get("WOWS_PERSONAS_DIR", str(_BOT_DATA / "personas")))
PERSONA_FORCE = os.environ.get("WOWS_PERSONA", "").strip()  # e.g. "aichan" / "shion",空=随机

RESULT_CN = {"Win": "胜利", "Loss": "失败", "Draw": "平局"}


def log(msg):
    print(msg, file=sys.stderr)


def fmt_int(v):
    return f"{int(v or 0):,}".replace(",", " ")


def ship_label(p):
    idx = p["ship"].get("index", "")
    raw_name = clean_ship_name(p["ship"]["name"])
    zh = t(f"IDS_{idx}", raw_name) if idx else raw_name
    species = strip_known(p["ship"]["species"]) or "?"
    return f"{zh} L{p['ship']['level']} {species}"


def mode_zh(m):
    mg_raw = m.get("match_group", "")
    gm_raw = m.get("game_mode", "")
    mg = MATCH_GROUP_CN.get(mg_raw, mg_raw)
    gm = t(f"IDS_SCENARIO_{gm_raw.upper()}", t(f"IDS_{gm_raw.upper()}", gm_raw))
    return f"{mg}·{gm}" if gm else mg


# ---------- 新增: 给 LLM 一些"抓手"信号(武器分布/受伤来源/勋带/队内排名) ---------

def dmg_breakdown(ri, categories, max_items=5):
    """Top-N (label, value, pct) for one side (DEALT or RECEIVED). [] if no data."""
    agg = aggregate(ri, categories)  # [(label, color, value)] desc, drops zeros
    total = sum(v for _, _, v in agg)
    if total <= 0:
        return []
    return [(lab, v, v / total * 100) for lab, _c, v in agg[:max_items]]


def top_dmg_label(ri, max_items=2, threshold_pct=20):
    """给队伍表里每行的简短"主输出类型"标签 — 列出占比 >= threshold 的前 max_items 项。"""
    parts = dmg_breakdown(ri, DEALT_CATEGORIES, max_items=max_items)
    keep = [(lab, pct) for lab, _v, pct in parts if pct >= threshold_pct]
    if not keep:
        return ""
    return " · ".join(f"{lab} {pct:.0f}%" for lab, pct in keep)


def rank_in_team(self_p, team, key_fn):
    """返回 self_p 在 team 里按 key_fn 排第几 (1-based) 以及该值, 没数据返回 (None, 0)。"""
    rows = [(p, key_fn(p) or 0) for p in team]
    rows.sort(key=lambda x: -x[1])
    for i, (p, v) in enumerate(rows, 1):
        if p is self_p:
            return i, v
    return None, 0


# 勋带按这个顺序输出,小到大概念性分组(主炮 → 副炮/防空 → 异常击中 → 击杀类 → 反潜/损管)
_RIBBON_ORDER = [
    "主炮命中", "穿透", "未穿", "过穿", "跳弹", "命中装甲区",
    "副炮", "击落", "瘫痪",
    "纵火", "进水",
    "击沉", "协助击杀", "摧毁建筑",
    "鱼雷命中", "鱼雷防护命中", "鱼雷防护被吸收",
    "深弹命中", "深弹直击", "深弹溅伤",
    "拾取增益",
]


def format_ribbons(ri):
    items = extract_ribbons(ri)  # [(label, icon, count)]
    by_label = {lab: cnt for lab, _icon, cnt in items}
    ordered = [(lab, by_label[lab]) for lab in _RIBBON_ORDER if lab in by_label]
    leftovers = [(lab, cnt) for lab, cnt in by_label.items() if lab not in set(_RIBBON_ORDER)]
    return " | ".join(f"{lab}×{cnt}" for lab, cnt in ordered + leftovers)


def build_summary(raw):
    """把 battle JSON 压成给 LLM 看的纯文本摘要 (1-3K 字符)。"""
    load_translations()
    load_result_indices()

    m = raw["match"]
    players = raw.get("players", [])
    self_name = m.get("self_player_name")
    self_p = next((p for p in players if p["name"] == self_name), None)

    map_raw = m.get("map_name", "").split("/")[-1]
    map_disp = t(f"IDS_SPACES/{map_raw.upper()}", map_raw)

    br = m.get("battle_result") or {}
    win_type = br.get("type", "Draw")
    win_team = br.get("team_id", -1)
    result_zh = RESULT_CN.get(win_type, win_type)

    scores = {ts["team_index"]: ts.get("score", 0) for ts in m.get("team_scores", [])}
    self_team = (self_p.get("team_id") if self_p else 0) or 0
    enemy_team = 1 if self_team == 0 else 0
    score_str = f"{scores.get(self_team, '?')} : {scores.get(enemy_team, '?')}"
    # 主角视角的结果 (battle_result.type 是赢家视角,改成主角)
    if win_team != -1 and self_p is not None:
        result_zh = "胜利" if win_team == self_team else ("平局" if win_type == "Draw" else "失败")

    dur_played = m.get("duration_seconds_played") or m.get("duration_seconds_max") or 0

    lines = []
    lines.append(f"WoWs 战报 ({m.get('client_version', '?')})")
    lines.append(f"地图: {map_disp} | 模式: {mode_zh(m)} | 时长: {fmt_time(int(dur_played))} | "
                 f"结果: {result_zh} ({score_str})")
    lines.append(f"日期: {m.get('date_time', '?')}")

    # ----- 主角 -----
    if self_p is not None:
        ri = self_p.get("results_info") or []
        st = self_p.get("stats") or {}
        max_hp = st.get("max_health", 0) or 0
        final_hp = st.get("final_health", 0) or 0
        taken = max(0, int(max_hp - final_hp))
        dmg = st.get("damage_dealt") or 0
        kills = st.get("frags") or 0  # JSON 里键名是 frags 不是 kills
        spotting = result_field(ri, "scouting_damage", 0) or 0
        potential = sum((result_field(ri, k, 0) or 0)
                        for k in ("agro_art", "agro_air", "agro_tpd", "agro_dbomb"))
        xp = result_field(ri, "exp", 0) or 0
        time_lived = st.get("time_lived_secs")
        plane_kills = (result_field(ri, "planes_killed_by_ship", 0) or 0) + \
                      (result_field(ri, "planes_killed_by_plane", 0) or 0)

        lines.append("")
        lines.append(f"【主角】{self_p['name']}  {ship_label(self_p)}")
        lines.append(
            f"  击杀 {kills} | 击伤 {fmt_int(dmg)} | 飞机 {plane_kills} | "
            f"侦查 {fmt_int(spotting)} | 潜在 {fmt_int(potential)} | 经验 {fmt_int(xp)}"
        )
        cause = strip_known(st.get("death_cause") or "") if not st.get("is_alive") else ""
        live_str = (
            "生还(全程)" if st.get("is_alive") else
            f"阵亡 ({cause}, 存活 {fmt_time(int(time_lived))})" if time_lived is not None else
            f"阵亡 ({cause})"
        )
        lines.append(
            f"  血量 {fmt_int(final_hp)}/{fmt_int(max_hp)} 承伤 {fmt_int(taken)} | {live_str}"
        )

        # --- 输出武器分布(主角) ---
        dealt_top = dmg_breakdown(ri, DEALT_CATEGORIES, max_items=6)
        if dealt_top:
            total_d = sum(v for _, v, _ in dealt_top)  # 仅 top-6 总和,仅用于上下文
            lines.append("  输出分布: " + " · ".join(
                f"{lab} {fmt_int(v)} ({pct:.0f}%)" for lab, v, pct in dealt_top
            ))

        # --- 受伤来源(主角) ---
        recvd_top = dmg_breakdown(ri, RECEIVED_CATEGORIES, max_items=6)
        if recvd_top:
            recvd_total = sum((result_field(ri, k, 0) or 0)
                              for _, _, keys in RECEIVED_CATEGORIES for k in keys)
            healed = max(0, recvd_total - taken)
            lines.append(
                f"  受伤来源 (累计被打 {fmt_int(recvd_total)} / 实际承伤 {fmt_int(taken)} / 被治疗 {fmt_int(healed)}): "
                + " · ".join(f"{lab} {fmt_int(v)} ({pct:.0f}%)" for lab, v, pct in recvd_top)
            )

        # --- 勋带(主角) ---
        rib = format_ribbons(ri)
        if rib:
            lines.append(f"  勋带: {rib}")

        # --- 主角在己方阵营的排名(让 LLM 知道这分数算高还是低) ---
        own_team = [p for p in players if p.get("team_id") == self_team]
        if len(own_team) > 1:
            def _pot(p):
                ri_ = p.get("results_info")
                return sum((result_field(ri_, k, 0) or 0)
                           for k in ("agro_art", "agro_air", "agro_tpd", "agro_dbomb"))
            r_dmg,  _ = rank_in_team(self_p, own_team, lambda p: (p.get("stats") or {}).get("damage_dealt"))
            r_spot, _ = rank_in_team(self_p, own_team, lambda p: result_field(p.get("results_info"), "scouting_damage", 0) or 0)
            r_pot,  _ = rank_in_team(self_p, own_team, _pot)
            r_xp,   _ = rank_in_team(self_p, own_team, lambda p: result_field(p.get("results_info"), "exp", 0) or 0)
            r_kill, _ = rank_in_team(self_p, own_team, lambda p: (p.get("stats") or {}).get("frags"))
            lines.append(
                f"  队内排名 (己方 {len(own_team)} 人): "
                f"击伤 #{r_dmg} · 击杀 #{r_kill} · 侦查 #{r_spot} · 潜在 #{r_pot} · 经验 #{r_xp}"
            )

    # ----- 双队战绩 -----
    def team_block(label, tid):
        team = [p for p in players if p.get("team_id") == tid]
        if not team:
            return []
        team.sort(key=lambda p: -((p.get("stats") or {}).get("damage_dealt") or 0))
        alive = sum(1 for p in team if (p.get("stats") or {}).get("is_alive"))
        total_dmg = sum(((p.get("stats") or {}).get("damage_dealt") or 0) for p in team)
        total_frags = sum(((p.get("stats") or {}).get("frags") or 0) for p in team)
        out = ["", f"【{label}】{alive}/{len(team)} 存活, 总击伤 {fmt_int(total_dmg)}, 总击杀 {total_frags}"]
        for p in team:
            st = p.get("stats") or {}
            ri = p.get("results_info") or []
            mark = "★" if p["name"] == self_name else " "
            cause = ""
            if not st.get("is_alive"):
                cause_raw = strip_known(st.get("death_cause") or "")
                cause = f"亡于{cause_raw}" if cause_raw else "亡"
            else:
                cause = "存"
            wpn = top_dmg_label(ri)  # 主输出类型: e.g. "主炮 AP 73%" 或 "跳炸 31% · 鱼雷机 36%"
            wpn_str = f"  [{wpn}]" if wpn else ""
            out.append(
                f"  {mark}{p['name']:<22} {ship_label(p):<28} "
                f"K{st.get('frags', 0) or 0} D{fmt_int(st.get('damage_dealt', 0))} "
                f"{cause}{wpn_str}"
            )
        return out

    lines.extend(team_block("己方阵营", self_team))
    lines.extend(team_block("敌方阵营", enemy_team))

    # ----- 死亡时间轴 -----
    deaths_raw = raw.get("deaths", [])
    if deaths_raw:
        # 建 entity_id -> (name, team) 映射,标谁死的+在哪边
        eid_map = {}
        for p in players:
            eid = strip_id(p.get("vehicle_entity_id") or p.get("entity_id") or "")
            if eid:
                eid_map[eid] = (p["name"], p.get("team_id"))

        lines.append("")
        lines.append("【死亡时间轴】")
        sorted_deaths = sorted(deaths_raw, key=lambda d: float(d.get("time_secs", 0)))
        for d in sorted_deaths:
            t_sec = float(d.get("time_secs", 0))
            victim_eid = strip_id(d.get("victim_entity_id") or "")
            killer_eid = strip_id(d.get("killer_entity_id") or "")
            cause = strip_known(d.get("cause", "?"))
            victim_name, victim_team = eid_map.get(victim_eid, (d.get("victim_name", "?"), -1))
            killer_name, _ = eid_map.get(killer_eid, ("环境", -1))
            side = "己" if victim_team == self_team else ("敌" if victim_team == enemy_team else "?")
            lines.append(f"  {fmt_time(int(t_sec))} [{side}] {victim_name} ← {killer_name} ({cause})")

    return "\n".join(lines)


FALLBACK_PROMPT = """你是战舰世界 (World of Warships) 的资深玩家兼教练,
基于给定的对局战报,用中文给玩家写一段简短的战后复盘 (200-400 字)。
要求: 先点输赢关键 → 玩家亮点+失误 → 关键转折点。不要 markdown 标题/列表。
"""


def _read_prompt_file(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            text = f.read().strip()
        return text or None
    except (FileNotFoundError, OSError):
        return None


def load_prompt():
    """选 system prompt,优先级如下:
       1. WOWS_ANALYZE_PROMPT 指了具体文件 → 用它(老接口,兼容)。
       2. WOWS_PERSONAS_DIR 下能找到至少一个 .txt:
          - WOWS_PERSONA=<name> 强制选 personas/<name>.txt
          - 否则在所有 .txt 里随机抽一个 (bot 用)
       3. 都没找到 → 用兜底常量 FALLBACK_PROMPT。
    """
    # 1. 显式单文件强制覆盖
    if PROMPT_FILE:
        text = _read_prompt_file(PROMPT_FILE)
        if text:
            log(f"loaded prompt (explicit override): {PROMPT_FILE} ({len(text)} chars)")
            return text
        log(f"warn: WOWS_ANALYZE_PROMPT={PROMPT_FILE} 读不出来,继续走 personas")

    # 2. personas 目录
    if PERSONAS_DIR.is_dir():
        files = sorted(PERSONAS_DIR.glob("*.txt"))
        if files:
            picked = None
            if PERSONA_FORCE:
                forced = PERSONAS_DIR / f"{PERSONA_FORCE}.txt"
                if forced.is_file():
                    picked = forced
                else:
                    log(f"warn: 找不到 personas/{PERSONA_FORCE}.txt,随机回退")
            if picked is None:
                picked = random.choice(files)
            text = _read_prompt_file(picked)
            if text:
                log(f"loaded prompt (persona): {picked.name} ({len(text)} chars)")
                return text

    # 3. 兜底
    log("没找到任何 prompt 文件,用 fallback")
    return FALLBACK_PROMPT


def call_deepseek(summary):
    if not API_KEY:
        raise RuntimeError("缺 WOWS_DEEPSEEK_KEY 环境变量")

    body = json.dumps({
        "model": API_MODEL,
        "messages": [
            {"role": "system", "content": load_prompt()},
            {"role": "user", "content": summary},
        ],
        "stream": False,
        # 0.3 比默认 0.7 更"老实",显著减少 LLM 凭印象编反事实推测和"差点/说不定"类脑补
        "temperature": 0.3,
    }).encode("utf-8")

    req = urllib.request.Request(
        API_URL,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {API_KEY}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="ignore")[:500]
        raise RuntimeError(f"DeepSeek HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"DeepSeek 网络错误: {e}")

    try:
        return data["choices"][0]["message"]["content"].strip()
    except (KeyError, IndexError):
        raise RuntimeError(f"DeepSeek 响应无 content: {data}")


def main():
    if len(sys.argv) < 2:
        log("usage: wows_analyze <battle.json>")
        sys.exit(2)

    raw = json.load(open(sys.argv[1], encoding="utf-8"))
    log("[1/2] 压缩战报摘要 ...")
    summary = build_summary(raw)
    log(f"摘要 {len(summary)} 字符")

    log("[2/2] 调 DeepSeek ...")
    text = call_deepseek(summary)
    print(text)


if __name__ == "__main__":
    main()
