#!/usr/bin/env python3
"""wows_full_report_normalized — one-shot 战报+复盘 竖向拼接图 (new schema).

对新的 `replayshark battle-results --format normalized` 流水:解析回放 → 战报
(render_report_normalized) + 复盘 (render_review_normalized) → 竖向拼接。WG/Lesta
通吃(Lesta 需用含 Lesta 修复的 replayshark + Lesta 客户端数据)。

Usage:
    wows_full_report_normalized <replay> [out_dir]

Env:
    WOWS_REPLAYSHARK  replayshark 可执行(默认 BOT_HOME/replayshark)
    WOWS_GAME_DIR     WoWs/Korabli 客户端目录 (-g);或
    WOWS_EXTRACTED    预解包目录 (-e);二选一
    WOWS_CONSTANTS_JSON  可选 -c
    WOWS_PYTHON / WOWS_PY_VENV  Python 解释器
    WOWS_OUT_DIR      默认输出目录
输出 <out_dir>/<basename>.full.png,stdout 末行为该路径。
"""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from wowsbot import paths          # noqa: E402

BOT_HOME = paths.REPORT_ROOT
REPLAYSHARK = paths.REPLAYSHARK
BIN = paths.BIN_DIR
DEFAULT_OUT = paths.OUT_DIR
GAP, BG = 16, (18, 24, 38)


def find_python():
    override = os.environ.get("WOWS_PYTHON")
    if override:
        return override
    venv = os.environ.get("WOWS_PY_VENV") or str(BOT_HOME / "venv")
    cand = Path(venv) / "bin" / "python"
    return str(cand) if cand.exists() else "python3"


def main():
    if len(sys.argv) < 2:
        print("usage: wows_full_report_normalized <replay> [out_dir]", file=sys.stderr)
        sys.exit(2)
    replay = Path(sys.argv[1]).expanduser().resolve()
    out_dir = Path(sys.argv[2] if len(sys.argv) >= 3 else DEFAULT_OUT).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)
    base = replay.stem
    json_path = out_dir / f"{base}.json"
    report_png = out_dir / f"{base}.report.png"
    review_png = out_dir / f"{base}.review.png"
    full_png = out_dir / f"{base}.full.png"

    # 1) parse → normalized JSON
    cmd = [REPLAYSHARK]
    if os.environ.get("WOWS_GAME_DIR"):
        cmd += ["-g", os.environ["WOWS_GAME_DIR"]]
    elif os.environ.get("WOWS_EXTRACTED"):
        cmd += ["-e", os.environ["WOWS_EXTRACTED"]]
    if os.environ.get("WOWS_CONSTANTS_JSON") and Path(os.environ["WOWS_CONSTANTS_JSON"]).is_file():
        cmd += ["-c", os.environ["WOWS_CONSTANTS_JSON"]]
    cmd += ["battle-results", "--format", "normalized", "--out-file", str(json_path), str(replay)]
    print("[1/4] replayshark battle-results (normalized) ...", file=sys.stderr)
    subprocess.run(cmd, check=True, stdout=sys.stderr)

    # Lesta: recover per-player base XP / planes / received-damage from the replay
    # file's results block (block 1) — the packet stream carries no server results,
    # but the file does. No-op for WG replays. Self-validates before merging.
    try:
        import json as _json
        sys.path.insert(0, str(BIN))
        import lesta_public_results as lpr  # noqa: E402
        with open(json_path, encoding="utf-8") as _fh:
            _norm = _json.load(_fh)
        if lpr.enrich(_norm, str(replay)):
            with open(json_path, "w", encoding="utf-8") as _fh:
                _json.dump(_norm, _fh, ensure_ascii=False)
            print("      + Lesta 公开结算已合并 (基础经验/飞机)", file=sys.stderr)
    except Exception as _e:
        print(f"      (Lesta 结算合并跳过: {_e})", file=sys.stderr)

    py = find_python()
    print("[2/4] 战报 ...", file=sys.stderr)
    # When stitching, skip the battle report's own 个人战绩 band + footer — the
    # 复盘 half below already carries per-self stats and the final footer (matches
    # wows_full_report / the EssexBot layout).
    report_env = os.environ.copy()
    report_env["WOWS_SKIP_PERSONAL"] = "1"
    report_env["WOWS_SKIP_FOOTER"] = "1"
    subprocess.run([py, str(BIN / "render_report_normalized.py"), str(json_path), str(report_png)],
                   check=True, stdout=sys.stderr, env=report_env)
    print("[3/4] 复盘 ...", file=sys.stderr)
    subprocess.run([py, str(BIN / "render_review_normalized.py"), str(json_path), str(review_png)],
                   check=True, stdout=sys.stderr)

    print("[4/4] 拼接 ...", file=sys.stderr)
    from PIL import Image
    a = Image.open(report_png).convert("RGB")
    b = Image.open(review_png).convert("RGB")
    if b.width != a.width:
        b = b.resize((a.width, round(b.height * a.width / b.width)), Image.LANCZOS)
    canvas = Image.new("RGB", (a.width, a.height + GAP + b.height), BG)
    canvas.paste(a, (0, 0))
    canvas.paste(b, (0, a.height + GAP))
    canvas.save(full_png)

    print(f"saved: {full_png}", file=sys.stderr)
    print(full_png)


if __name__ == "__main__":
    main()
