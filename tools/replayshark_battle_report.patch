+fn run_consumables_dump(
+    extracted_dir: Option<&str>,
+    output: Option<&Path>,
+) -> anyhow::Result<()> {
+    use wowsunpack::game_params::provider::GameMetadataProvider;
+    use wowsunpack::game_params::types::{GameParamProvider, ParamData};
+    use wowsunpack::vfs::PhysicalFS;
+    use wowsunpack::vfs::VfsPath;
+
+    let extracted = extracted_dir.ok_or_else(|| anyhow!("--extracted is required"))?;
+    let path = Path::new(extracted);
+
+    // 支持两种布局:
+    //   a) path/{content,scripts}/...        (战报 bot 自带 specs)
+    //   b) path/vfs/{content,scripts}/...    (wows-data-mgr 解出来的)
+    //   c) path/<ver_build>/vfs/...          (含版本子目录的)
+    let vfs_dir = if path.join("content").join("GameParams.data").is_file() {
+        path.to_path_buf()
+    } else if path.join("vfs").join("content").is_dir() {
+        path.join("vfs")
+    } else {
+        let mut chosen: Option<PathBuf> = None;
+        if let Ok(entries) = std::fs::read_dir(path) {
+            for entry in entries.flatten() {
+                let sub = entry.path();
+                if sub.join("vfs").join("content").is_dir() {
+                    chosen = Some(sub.join("vfs"));
+                    break;
+                }
+            }
+        }
+        chosen.ok_or_else(|| anyhow!("没在 {} 下找到 content/GameParams.data", path.display()))?
+    };
+
+    eprintln!("loading GameParams.data from {} ...", vfs_dir.display());
+    let vfs: VfsPath = VfsPath::new(PhysicalFS::new(&vfs_dir));
+    let provider = GameMetadataProvider::from_vfs(&vfs).map_err(|e| anyhow!("{}", e))?;
+
+    let mut abilities = Vec::new();
+    let mut planes = Vec::new();
+    for param in provider.params() {
+        match param.data() {
+            ParamData::Ability(ab) => {
+                let mut cats = Vec::new();
+                for (variant_name, cat) in ab.categories() {
+                    cats.push(serde_json::json!({
+                        "variant": variant_name,
+                        "consumable_type_raw": cat.consumable_type_raw(),
+                        "work_time": cat.work_time(),
+                    }));
+                }
+                abilities.push(serde_json::json!({
+                    "ability_name": param.name(),
+                    "ability_index": param.index(),
+                    "num_variants": cats.len(),
+                    "variants": cats,
+                }));
+            }
+            ParamData::Aircraft(a) => {
+                let plane_consumables: Vec<Vec<String>> = a.abilities().map(|slots| {
+                    slots.iter()
+                        .filter(|s| !s.is_empty())
+                        .map(|slot| slot.iter().map(|(name, _)| name.clone()).collect())
+                        .collect()
+                }).unwrap_or_default();
+                planes.push(serde_json::json!({
+                    "plane_name": param.name(),
+                    "plane_index": param.index(),
+                    "category": format!("{:?}", a.category()),
+                    "ammo_type": a.ammo_type(),
+                    "consumable_slots": plane_consumables,
+                }));
+            }
+            _ => {}
+        }
+    }
+    abilities.sort_by(|a, b| {
+        a["ability_name"].as_str().unwrap_or("").cmp(b["ability_name"].as_str().unwrap_or(""))
+    });
+    planes.sort_by(|a, b| {
+        a["plane_index"].as_str().unwrap_or("").cmp(b["plane_index"].as_str().unwrap_or(""))
+    });
+
+    eprintln!("found {} Ability params, {} Aircraft params", abilities.len(), planes.len());
+    let json = serde_json::to_string_pretty(&serde_json::json!({
+        "abilities": abilities,
+        "planes": planes,
+        "total_abilities": abilities.len(),
+        "total_planes": planes.len(),
+    }))?;
+    if let Some(out) = output {
+        std::fs::write(out, json)?;
+        eprintln!("wrote to {}", out.display());
+    } else {
+        println!("{}", json);
+    }
+    Ok(())
+}
