+fn run_battle_report(
+    replay: &Path,
+    extracted_dir: Option<&str>,
+    constants_path: Option<&Path>,
+    output: Option<&Path>,
+) -> anyhow::Result<()> {
+    use wowsunpack::data::ResourceLoader;
+    use wowsunpack::game_params::provider::GameMetadataProvider;
+    use wowsunpack::game_params::types::ParamData;
+    use wowsunpack::vfs::PhysicalFS;
+    use wowsunpack::vfs::VfsPath;
+    use wows_replays::analyzer::battle_controller::BattleController;
+
+    let extracted = extracted_dir.ok_or_else(|| anyhow!("--extracted is required for battle-report"))?;
+    let replay_file = ReplayFile::from_file(replay).map_err(|e| anyhow!("failed to read replay: {}", e))?;
+    let version = Version::from_client_exe(&replay_file.meta.clientVersionFromExe);
+
+    let extracted_dir = resolve_extracted_dir(Path::new(extracted), &version)?;
+    let vfs: VfsPath = VfsPath::new(PhysicalFS::new(&extracted_dir));
+
+    eprintln!("loading GameParams.data ...");
+    let provider = GameMetadataProvider::from_vfs(&vfs).map_err(|e| anyhow!("{}", e))?;
+
+    let gc = load_game_constants(constants_path, version.build);
+
+    eprintln!("running BattleController over {} bytes of packets ...", replay_file.packet_data.len());
+    let mut controller = BattleController::new(&replay_file.meta, &provider, Some(gc));
+    let mut parser = wows_replays::packet2::Parser::new(provider.entity_specs());
+
+    let mut remaining = &replay_file.packet_data[..];
+    let mut count = 0usize;
+    while !remaining.is_empty() {
+        match parser.parse_packet(&mut remaining) {
+            Ok(packet) => {
+                controller.process(&packet);
+                count += 1;
+            }
+            Err(e) => {
+                eprintln!("parse_packet error after {} packets: {:?}", count, e);
+                break;
+            }
+        }
+    }
+    controller.finish();
+    eprintln!("processed {} packets, building flat report ...", count);
+
+    let report = controller.build_report();
+
+    // Build a JSON-friendly flat structure (BattleReport has HashMap with non-string keys)
+    let mut players_json = Vec::new();
+    let mut deaths_json = Vec::new();
+
+    for player in report.players() {
+        let vehicle_param = player.vehicle();
+        let (level, species_str, consumable_slots) = match vehicle_param.data() {
+            ParamData::Vehicle(v) => {
+                let species = vehicle_param.species().map(|s| format!("{:?}", s));
+                // 从 Vehicle.abilities 提取该船能装的消耗品类型(去重)。
+                // abilities = Vec<Vec<(ability_name, variant_name)>>:
+                //   外层 = slot 索引 (1-6),内层 = 该 slot 的所有候选 variant。
+                // 我们只关心存在的(非空) slot,且每个 slot 取 first variant 即可
+                // (同一 slot 的所有 variant 都是同一消耗品类型)。
+                // 按 slot 嵌套 dump:外层 = slot 索引,内层 = 该 slot 的所有可选
+                // ability_name (玩家二选一)。这样 Python 端判断"slot 0 次使用"时,
+                // 只要 slot 内任何一个 variant 被用过就算用过,避免把"侦察机/战斗机
+                // 二选一 slot"误判成"两种都没开"。
+                // 注:Rust 端 Ability.categories() 在新版本 WoWs GameParams parse 为空,
+                // 拿不到 consumable_type 枚举,只能 dump 原始 ability_name 让 Python
+                // 按关键字模式识别(PCY010_RLSSearch -> 雷达 等)。
+                let mut consumable_slots: Vec<Vec<String>> = Vec::new();
+                if let Some(slots) = v.abilities() {
+                    for slot in slots {
+                        if slot.is_empty() {
+                            continue;
+                        }
+                        let alternatives: Vec<String> = slot.iter()
+                            .map(|(ab_name, _)| ab_name.clone())
+                            .collect();
+                        consumable_slots.push(alternatives);
+                    }
+                }
+                // CV: 把每个挂载飞机的 PlaneAbilities 也并入 slot 列表(去重),
+                // 这样 Python 端检测时能识别"巡逻战斗机/引擎冷却带了但 0 次使用"。
+                use wowsunpack::game_params::types::GameParamProvider as GPP;
+                for plane_idx in v.plane_refs() {
+                    // plane_refs 来自 ship pickle 的 planes 列表,实际是 param 的 name(不是 index)
+                    let Some(plane_param) = GPP::game_param_by_name(&provider, plane_idx) else { continue };
+                    let ParamData::Aircraft(plane) = plane_param.data() else { continue };
+                    let Some(plane_slots) = plane.abilities() else { continue };
+                    for slot in plane_slots {
+                        if slot.is_empty() { continue; }
+                        let alternatives: Vec<String> = slot.iter()
+                            .map(|(ab_name, _)| ab_name.clone())
+                            .collect();
+                        if !consumable_slots.contains(&alternatives) {
+                            consumable_slots.push(alternatives);
+                        }
+                    }
+                }
+                (v.level() as i64, species.unwrap_or_else(|| "?".to_string()), consumable_slots)
+            }
+            _ => (0i64, "?".to_string(), Vec::<Vec<String>>::new()),
+        };
+        let ship_index = vehicle_param.index().to_string();
+        let ship_id = format!("{:?}", vehicle_param.id());
+
+        let veh_opt = player.vehicle_entity();
+        let vehicle_entity_id = veh_opt.map(|v| format!("{:?}", v.id()));
+        let results_info = veh_opt.and_then(|v| v.results_info().cloned());
+        let (damage, frags, max_hp, final_hp, is_alive, time_lived_secs, killer_id, death_cause) =
+            if let Some(v) = veh_opt {
+                let max_hp = v.props().max_health() as f64;
+                let cur_hp = v.props().health() as f64;
+                let dmg = v.damage();
+                let frags_n = v.frags().len();
+                let (dt, kid, cause) = if let Some(di) = v.death_info() {
+                    let cause_str = format!("{:?}", di.cause());
+                    (
+                        Some(di.time_lived().as_secs_f64()),
+                        Some(format!("{:?}", di.killer())),
+                        Some(cause_str),
+                    )
+                } else {
+                    (None, None, None)
+                };
+                let is_alive = v.death_info().is_none();
+                (dmg, frags_n, max_hp, cur_hp, is_alive, dt, kid, cause)
+            } else {
+                (0.0_f64, 0_usize, 0.0_f64, 0.0_f64, true, None, None, None)
+            };
+
+        let init_state = player.initial_state();
+        let player_name = init_state.username().to_string();
+        let account_id = init_state.db_id();
+
+        // Use each player's own death_info as the canonical "X died at T, killed by K" event
+        if let Some(v) = veh_opt {
+            if let Some(di) = v.death_info() {
+                deaths_json.push(serde_json::json!({
+                    "time_secs": di.time_lived().as_secs_f64(),
+                    "victim_name": player_name,
+                    "victim_account_id": format!("{:?}", account_id),
+                    "victim_entity_id": format!("{:?}", v.id()),
+                    "killer_entity_id": format!("{:?}", di.killer()),
+                    "cause": format!("{:?}", di.cause()),
+                }));
+            }
+        }
+
+        // 本局配装 — 舰长 + 已学技能 + 改装件 + 信号旗/伪装。
+        // 数据来源:VehicleProps (订阅包,自己/队友/敌人全程可见)。
+        // 老 replay 或异常 entity (vehicle_entity 为 None) 时整块为 null,Python 端跳过。
+        let build_json = veh_opt.map(|v| {
+            let props = v.props();
+            let cmc = props.crew_modifiers_compact_params();
+            let cfg = props.ship_config();
+            // for_species 要 &Species;species 不可识别时给空技能列表,而不是猜一个
+            let species_ref = vehicle_param.species().and_then(|r| r.known());
+            let crew_skills: Vec<u8> = species_ref
+                .map(|sp| cmc.learned_skills().for_species(sp).to_vec())
+                .unwrap_or_default();
+            serde_json::json!({
+                "crew_id":        cmc.params_id(),
+                "crew_skills":    crew_skills,
+                "modernizations": cfg.modernization(),
+                "exteriors":      cfg.exteriors(),
+            })
+        });
+
+        players_json.push(serde_json::json!({
+            "account_id": format!("{:?}", account_id),
+            "name": player_name,
+            "clan": init_state.clan(),
+            "team_id": init_state.team_id(),
+            "relation": format!("{:?}", player.relation()),
+            "is_bot": false,
+            "ship": {
+                "id": ship_id,
+                "index": ship_index,
+                "name": player.vehicle().name(),
+                "level": level,
+                "species": species_str,
+                // consumable_slots: 嵌套结构,外层 slot,内层 alt ability_names
+                "consumable_slots": consumable_slots,
+                // build: 本局配装 (舰长/技能/升级/旗帜),vehicle_entity 缺失时为 null
+                "build": build_json,
+            },
+            "stats": {
+                "damage_dealt": damage,
+                "frags": frags,
+                "max_health": max_hp,
+                "final_health": final_hp,
+                "is_alive": is_alive,
+                "time_lived_secs": time_lived_secs,
+                "killer_entity_id": killer_id,
+                "death_cause": death_cause,
+            },
+            "meta_ship_id": format!("{:?}", init_state.meta_ship_id()),
+            "vehicle_entity_id": vehicle_entity_id,
+            "results_info": results_info,
+        }));
+    }
+
+    let mut team_scores = Vec::new();
+    for ts in report.team_scores() {
+        team_scores.push(serde_json::json!({
+            "team_index": ts.team_index,
+            "score": ts.score,
+        }));
+    }
+
+    let battle_result = report.battle_result();
+
+    let chat_log: Vec<_> = report
+        .game_chat()
+        .iter()
+        .map(|m| {
+            serde_json::json!({
+                "sender_name": m.sender_name,
+                "sender_relation": m.sender_relation.map(|r| format!("{:?}", r)),
+                "channel": format!("{:?}", m.channel),
+                "message": m.message,
+            })
+        })
+        .collect();
+
+    // Per-event damage timeline (attacker, victim, elapsed seconds, amount).
+    // Format entity IDs as "EntityId(N)" strings to match other ID fields in this JSON
+    // so Python-side strip_id() works uniformly.
+    let damage_events_json: Vec<_> = report
+        .damage_events()
+        .iter()
+        .map(|e| {
+            serde_json::json!({
+                "time_secs": e.time_secs,
+                "attacker_entity_id": format!("EntityId({})", e.attacker_entity_id),
+                "victim_entity_id": format!("EntityId({})", e.victim_entity_id),
+                "amount": e.amount,
+            })
+        })
+        .collect();
+
+    // Per-event consumable activation log (user, consumable type, elapsed seconds).
+    let consumable_uses_json: Vec<_> = report
+        .consumable_uses()
+        .iter()
+        .map(|u| {
+            serde_json::json!({
+                "time_secs": u.time_secs,
+                "user_entity_id": format!("EntityId({})", u.user_entity_id),
+                "consumable_name": u.consumable_name,
+            })
+        })
+        .collect();
+
+    // Per-event CV plane consumable activation log. Only the recording player's
+    // CV produces entries (Avatar single-cast); downstream tools should treat
+    // absence-of-data as "unknown" for non-self CVs, not as "0 uses".
+    let squadron_consumable_uses_json: Vec<_> = report
+        .squadron_consumable_uses()
+        .iter()
+        .map(|u| {
+            serde_json::json!({
+                "time_secs": u.time_secs,
+                "avatar_entity_id": format!("EntityId({})", u.avatar_entity_id),
+                "owner_entity_id": format!("EntityId({})", u.owner_entity_id),
+                "squadron_id": u.squadron_id,
+                "consumable_name": u.consumable_name,
+            })
+        })
+        .collect();
+
+    let out_json = serde_json::json!({
+        "match": {
+            "map_name": report.map_name(),
+            "version": format!("{:?}", report.version()),
+            "game_mode": report.game_mode(),
+            "match_group": report.match_group(),
+            "game_type": format!("{:?}", report.game_type()),
+            "duration_seconds_max": report.max_duration(),
+            "duration_seconds_played": report.played_duration(),
+            "arena_id": report.arena_id(),
+            "battle_result": battle_result,
+            "team_scores": team_scores,
+            "self_player_name": replay_file.meta.playerName,
+            "self_vehicle": replay_file.meta.playerVehicle,
+            "date_time": replay_file.meta.dateTime,
+        },
+        "players": players_json,
+        "deaths": deaths_json,
+        "damage_events": damage_events_json,
+        "consumable_uses": consumable_uses_json,
+        "squadron_consumable_uses": squadron_consumable_uses_json,
+        "chat": chat_log,
+    });
+
+    let json = serde_json::to_string_pretty(&out_json)?;
+
+    if let Some(out) = output {
+        std::fs::write(out, json)?;
+        eprintln!("wrote JSON to {}", out.display());
+    } else {
+        println!("{}", json);
+    }
+    Ok(())
+}
