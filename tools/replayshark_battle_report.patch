+fn run_builds_dump(
+    extracted_dir: Option<&str>,
+    output: Option<&Path>,
+) -> anyhow::Result<()> {
+    use wowsunpack::game_params::provider::GameMetadataProvider;
+    use wowsunpack::game_params::types::{GameParamProvider, ParamData};
+    use wowsunpack::vfs::PhysicalFS;
+    use wowsunpack::vfs::VfsPath;
+    use std::collections::BTreeMap;
+
+    let extracted = extracted_dir.ok_or_else(|| anyhow!("--extracted is required"))?;
+    let path = Path::new(extracted);
+
+    // 复用 run_consumables_dump 的 vfs 探测:支持 path/、path/vfs/、path/<ver>/vfs/ 三种布局
+    let vfs_dir = if path.join("content").join("GameParams.data").is_file() {
+        path.to_path_buf()
+    } else if path.join("vfs").join("content").is_dir() {
+        path.join("vfs")
+    } else {
+        let mut chosen: Option<PathBuf> = None;
+        if let Ok(entries) = std::fs::read_dir(path) {
+            for entry in entries.flatten() {
+                let sub = entry.path();
+                if sub.join("vfs").join("content").is_dir() {
+                    chosen = Some(sub.join("vfs"));
+                    break;
+                }
+            }
+        }
+        chosen.ok_or_else(|| anyhow!("没在 {} 下找到 content/GameParams.data", path.display()))?
+    };
+
+    let meta = read_metadata(&vfs_dir).or_else(|| read_metadata(path));
+
+    eprintln!("loading GameParams.data from {} ...", vfs_dir.display());
+    let vfs: VfsPath = VfsPath::new(PhysicalFS::new(&vfs_dir));
+    let provider = GameMetadataProvider::from_vfs(&vfs).map_err(|e| anyhow!("{}", e))?;
+
+    // 对 Modernization / Exterior / Crew:简单地 (id, index) 入库,Python 端拼 IDS_<index> 查 .mo
+    let mut modernizations = Vec::new();
+    let mut exteriors = Vec::new();
+    let mut crews = Vec::new();
+    // Skill 是 dedupe by skill_type 的全局表 (同 skill_type 在不同 Crew 里指代同一技能,WoWs 技能树固定)
+    let mut skills: BTreeMap<usize, serde_json::Value> = BTreeMap::new();
+
+    for param in provider.params() {
+        match param.data() {
+            ParamData::Modernization(_) => {
+                modernizations.push(serde_json::json!({
+                    "id": param.id(),
+                    "index": param.index(),
+                    "name": param.name(),
+                }));
+            }
+            ParamData::Exterior(_) => {
+                exteriors.push(serde_json::json!({
+                    "id": param.id(),
+                    "index": param.index(),
+                    "name": param.name(),
+                }));
+            }
+            ParamData::Crew(crew) => {
+                crews.push(serde_json::json!({
+                    "id": param.id(),
+                    "index": param.index(),
+                    "name": param.name(),
+                }));
+                // 顺便从这位舰长身上抽 skill 表 (每位舰长技能列表都一样)
+                if let Some(skill_list) = crew.skills() {
+                    for sk in skill_list {
+                        let key = sk.skill_type();
+                        skills.entry(key).or_insert_with(|| {
+                            // IDS_SKILL_<UpperSnake(internal_name)> 是 wows-replays 已经用的约定 (controller.rs:1716)
+                            let upper_snake = to_upper_snake(sk.internal_name());
+                            serde_json::json!({
+                                "skill_type": key,
+                                "internal_name": sk.internal_name(),
+                                "name_key": format!("IDS_SKILL_{}", upper_snake),
+                                "tier": {
+                                    "AirCarrier": sk.tier().aircraft_carrier(),
+                                    "Battleship": sk.tier().battleship(),
+                                    "Cruiser":    sk.tier().cruiser(),
+                                    "Destroyer":  sk.tier().destroyer(),
+                                    "Submarine":  sk.tier().submarine(),
+                                    "Auxiliary":  sk.tier().auxiliary(),
+                                },
+                            })
+                        });
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    modernizations.sort_by(|a, b| a["index"].as_str().unwrap_or("").cmp(b["index"].as_str().unwrap_or("")));
+    exteriors.sort_by(|a, b| a["index"].as_str().unwrap_or("").cmp(b["index"].as_str().unwrap_or("")));
+    crews.sort_by(|a, b| a["index"].as_str().unwrap_or("").cmp(b["index"].as_str().unwrap_or("")));
+
+    let skills_arr: Vec<_> = skills.into_values().collect();
+    eprintln!(
+        "found {} modernizations / {} exteriors / {} crews / {} skills",
+        modernizations.len(), exteriors.len(), crews.len(), skills_arr.len()
+    );
+
+    let (version_str, build_num) = match meta {
+        Some(m) => (m.version, m.build),
+        None => ("?".to_string(), 0),
+    };
+    let json = serde_json::to_string_pretty(&serde_json::json!({
+        "version": version_str,
+        "build":   build_num,
+        "modernizations": modernizations,
+        "exteriors":      exteriors,
+        "crews":          crews,
+        "skills":         skills_arr,
+    }))?;
+    if let Some(out) = output {
+        std::fs::write(out, json)?;
+        eprintln!("wrote to {}", out.display());
+    } else {
+        println!("{}", json);
+    }
+    Ok(())
+}
+
+// IDS_SKILL_ key uses UPPER_SNAKE of CrewSkill.internal_name (mirrors controller.rs:1716).
+// Implemented manually to avoid pulling in convert_case as a new dep for replayshark.
+fn to_upper_snake(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 4);
+    let mut prev_lower = false;
+    for ch in s.chars() {
+        if ch.is_uppercase() && prev_lower {
+            out.push('_');
+        }
+        out.push(ch.to_ascii_uppercase());
+        prev_lower = ch.is_lowercase() || ch.is_ascii_digit();
+    }
+    out
+}
