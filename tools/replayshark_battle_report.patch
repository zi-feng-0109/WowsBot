+/// Serializable per-event damage record exposed via BattleReport.damage_events().
+/// Used by downstream tooling (战犯分析, 走位回放等) that needs the timeline,
+/// not just the aggregated per-player total in DamageEvent.
+#[derive(Serialize, Clone, Debug)]
+pub struct DamageEventOut {
+    /// Vehicle EntityId that dealt the damage (.raw() u32 form).
+    pub attacker_entity_id: u32,
+    /// Vehicle EntityId that received the damage.
+    pub victim_entity_id: u32,
+    /// Seconds elapsed since battle start (matches DeathInfo.time_lived semantics).
+    /// Negative values would mean pre-battle (shouldn't happen, but kept f32 for safety).
+    pub time_secs: f32,
+    /// Hit points dealt by this single event.
+    pub amount: f32,
+}
