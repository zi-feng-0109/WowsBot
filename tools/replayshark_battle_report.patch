+    /// Vehicle EntityId that activated the consumable (.raw() u32 form).
+    pub user_entity_id: u32,
+    /// Consumable variant name. Either the Debug name of the Known enum
+    /// (e.g. "Radar", "HydroacousticSearch") or the raw string for Unknown.
+    pub consumable_name: String,
+    /// Seconds elapsed since battle start.
+    pub time_secs: f32,
+}
